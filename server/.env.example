PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/x_auditory
MODEL_SERVICE_URL=http://127.0.0.1:8020
CLIENT_ORIGIN=http://localhost:8081
DEMO_USER_ID=demo-user

# Public resolvers used only if a mongodb+srv:// SRV lookup fails locally.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Abandon a model call after this long and report stage=model:timeout.
MODEL_TIMEOUT_MS=30000

# Reject uploads larger than this (bytes).
MAX_AUDIO_BYTES=26214400

# Detections scoring below this are returned with reason=low_confidence and are
# not persisted or notified. Set to 0 to persist every match.
MIN_CONFIDENCE=0.05

# Log any API request slower than this (ms).
SLOW_REQUEST_MS=400
