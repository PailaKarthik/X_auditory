# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Scripts that MUST keep LF or they break on their target shell.
*.sh          text eol=lf
gradlew       text eol=lf

# Windows-only scripts keep CRLF.
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Binary — never diff or convert.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.jar         binary
*.keystore    binary
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary
*.wav         binary
*.mp3         binary
*.ogg         binary
*.safetensors binary

# Keep generated lockfiles out of diffs and language stats.
package-lock.json  linguist-generated=true -diff
